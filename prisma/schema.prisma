generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/prisma/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  title       String
  category    String
  description String
  street      String   @unique
  mapsUrl     String   @unique
}
